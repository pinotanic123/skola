#include <iostream>
using namespace std;

bool provjeri_uvjete(double udaljenost, double masa) {
    return (masa <= 20 && udaljenost <= 30);
}

double izracunaj_cijenu(double udaljenost, double kosarica) {
    double cijena = 3.0 + (udaljenost * 0.40);
    if (kosarica >= 80) cijena -= 3.0;
    if (cijena < 0) cijena = 0;
    return cijena;
}

void prikazi(bool moguca, double cijena) {
    if (moguca) {
        cout.setf(ios::fixed);
        cout.precision(2);
        cout << "Dostava je moguca. Cijena: " << cijena << " EUR" << endl;
    }
    else {
        cout << "Dostava nije moguca." << endl;
    }
}

int main() {
    int kosarica;
    int udaljenost;
    int masa;

    cout << "Unesite vrijednost kosarice (EUR): ";
    cin >> kosarica;
    cout << "Unesite udaljenost (km): ";
    cin >> udaljenost;
    cout << "Unesite masu paketa (kg): ";
    cin >> masa;

    bool moguca = provjeri_uvjete(udaljenost, masa);
    double cijena = 0;

    if (moguca) {
        cijena = izracunaj_cijenu(udaljenost, kosarica);
    }
    prikazi(moguca, cijena);

    return 0;
}
