//LV4 1 PAKETI U SORTIRNICI

#include <iostream>
#include <iostream>
using namespace std;

int brojIznadPraga(int temp[][6], int redak, int P) {
    int broj = 0;

    for (int i = 0; i < 6; i++) {
        if (temp[redak][i] > P) {
            broj++;
        }
    }

    return broj;
}

int main() {
    int temp[4][6] = {
        {22, 24, 23, 25, 24, 26},
        {19, 20, 21, 20, 22, 21},
        {27, 29, 28, 31, 30, 29},
        {23, 23, 24, 22, 24, 25}
    };

    cout << "S0, P=24: "
        << brojIznadPraga(temp, 0, 24) << endl;

    cout << "S2, P=28: "
        << brojIznadPraga(temp, 2, 28) << endl;

    cout << "S1, P=25: "
        << brojIznadPraga(temp, 1, 25) << endl;

   
    cout << "S3, P=24: "
        << brojIznadPraga(temp, 3, 24) << endl;

    return 0;
}
