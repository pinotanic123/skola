#include <iostream>
using namespace std;

int pronadjiSrednjuVrijednost(int a, int b, int c) {
   
    if ((b <= a && a <= c) || (c <= a && a <= b)) {
        return a;
    }
  
    else if ((a <= b && b <= c) || (c <= b && b <= a)) {
        return b;
    }
    
    else {
        return c;
    }
}

int main() {
    int ocltanje1, ocitanje2, ocitanje3;

   
    cout << "Unesite tri ocitanja senzora (odvojena razmakom): ";
    cin >> ocltanje1 >> ocitanje2 >> ocitanje3;

    int pouzdanaUdaljenost = pronadjiSrednjuVrijednost(ocltanje1, ocitanje2, ocitanje3);

    cout << "Pouzdana udaljenost je: " << pouzdanaUdaljenost << " cm" << std::endl;

    return 0;
}
